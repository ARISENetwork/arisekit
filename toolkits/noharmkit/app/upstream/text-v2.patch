+
+.editor {
+  min-width: 0;
+}
+
+.editor > div {
+  min-width: 0;
+}
+
+.page {
+  container-type: inline-size;
+  width: 100%;
+  padding: 1.25rem 1.5rem 2rem;
+}
+
+.workspace {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1.25rem;
+}
+
+.workspace > aside {
+  position: static;
+  max-height: none;
+  overflow-y: visible;
+}
+
+@container (min-width: 68rem) {
+  .workspace {
+    grid-template-columns: minmax(15rem, min(28%, 23.75rem)) minmax(0, 1fr);
+  }
+
+  .workspace > aside {
+    position: sticky;
+    align-self: start;
+    max-height: calc(100vh - 6rem);
+    overflow-y: auto;
+  }
+}
+
+
+@container rubric-card (max-width: 51rem) {
+  .root [data-role-zone] [data-row-header] {
+    display: flex;
+    padding: .75rem 1rem .25rem 3rem;
+  }
+
+  .root [data-role-zone] [data-row-header] > :not(:nth-child(2)) {
+    display: none;
+  }
+}
