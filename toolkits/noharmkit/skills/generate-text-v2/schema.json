{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["caseId", "format", "usualCare", "decisions"],
  "additionalProperties": false,
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "format": {"const": "noharm-rubric-text-v2"},
    "usualCare": {
      "type": "object", "required": ["score", "harm"], "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 9},
        "harm": {"enum": ["none", "mild", "moderate", "severe"]}
      }
    },
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "question", "recommendations"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^C[2-9][0-9]*$|^C1[0-9]+$"},
          "kind": {"enum": ["followup", "plan"]},
          "question": {"type": "string", "minLength": 1},
          "recommendations": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "required": ["id", "text", "score", "harm", "tag"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^C[1-9][0-9]*\\.[0-9]+$"},
                "text": {"type": "string", "minLength": 1},
                "score": {"type": "integer", "minimum": 1, "maximum": 9},
                "harm": {"enum": ["none", "mild", "moderate", "severe"]},
                "tag": {"enum": ["diagnostic", "medication", "procedure", "counseling", "followup", "none"]},
                "addOn": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
