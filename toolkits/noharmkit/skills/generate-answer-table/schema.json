{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["caseId", "harmOverrides", "usualCare", "decisions"],
  "properties": {
    "caseId": {"type": "string"},
    "harmOverrides": {"const": true},
    "usualCare": {"type": "object", "required": ["harm"],
                  "properties": {"harm": {"enum": ["none", "mild", "moderate", "severe"]}}},
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "activation", "recommendations"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "activation": {"type": "object", "required": ["type"],
                         "properties": {"type": {"enum": ["always", "onlyIf", "future"]},
                                        "match": {"enum": ["any", "all"]}}},
          "recommendations": {"type": "array", "items": {"type": "object", "required": ["id", "text", "score"],
                              "properties": {"score": {"enum": [1, 2, 3, 4, 5, 6, 7, 8, 9]},
                                "tags": {"type": "array", "uniqueItems": true,
                                  "items": {"enum": ["diagnostic", "medication", "procedure", "counseling", "followUp", "none"]}}}}}
        }
      }
    }
  }
}
